# Social Oracle System Environment Configuration
# Copy this file to .env and fill in your actual values

# Reddit API Configuration
# Get these from https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=SocialOracle/1.0 by YourUsername

# Google Gemini AI API Configuration  
# Get API key from https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# BNB Smart Chain Configuration
# Use BNB Testnet RPC URL (default provided) or your own
BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# Blockchain Private Key
# IMPORTANT: Use a testnet-only private key, never use mainnet keys
# Get testnet BNB from https://testnet.binance.org/faucet-smart
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Optional: Custom Market Configuration
# These can be overridden in code, but useful for default testing
DEFAULT_MARKET_QUESTION=Will the community sentiment be positive about the upcoming update?
DEFAULT_SEARCH_KEYWORDS=update announcement community
DEFAULT_SUBREDDIT=cryptocurrency